# MaroqAndQuiz — Vercel loyihasi uchun muhit o'zgaruvchilari (Vercel → Settings → Environment Variables)
# Haqiqiy qiymatlarni hech qachon GitHub'ga yuklamang.

# Vercel Storage → Neon (Postgres) ni loyihaga ulaganda AVTOMATIK qo'shiladi:
DATABASE_URL=

# Vercel Storage → Blob store ni loyihaga ulaganda AVTOMATIK qo'shiladi:
BLOB_READ_WRITE_TOKEN=

# Ikkitasini O'ZINGIZ qo'shasiz:
ADMIN_PASSWORD=        # admin paroli, kamida 8 belgi
SESSION_SECRET=        # uzun tasodifiy matn, kamida 16 (tavsiya: 40) belgi
